{
  "manifest_version": 3,
  "name": "GSC URL Insights – Testbook",
  "version": "1.0.0",
  "description": "GSC Clicks, Impressions, Queries & Exam TAM for the current Testbook page",
  "permissions": ["identity", "activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://searchconsole.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/webmasters.readonly"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
