{
  "manifest_version": 3,
  "name": "GSC URL Insights – Testbook",
  "version": "1.0.0",
  "description": "GSC Clicks, Impressions, Queries & Exam TAM for the current Testbook page",
  "permissions": ["identity", "activeTab", "storage", "tabs"],
"host_permissions": [
  "https://www.googleapis.com/*",
  "https://searchconsole.googleapis.com/*",
  "https://*.testbook.com/*",
  "https://api.openai.com/*"
],
  "oauth2": {
    "client_id": "724972609650-87o79hhfrmt5o1rudpupcerrnr5fgp7f.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/webmasters.readonly"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.testbook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
